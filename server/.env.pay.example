# ============================================================
# Aggregated-payment config example (Yipay / Mapay / PayJS and compatible platforms)
# Copy this file to .env (or set the values as system environment variables), then restart relay_rs to apply.
# ============================================================

# Payment gateway order endpoint (often called "API URL" or "submit URL" in the platform console)
#   Rainbow Yipay : https://pay.example.com/submit.php
#   PayJS      : https://pay.example.com/submit.php
PAY_GATEWAY=https://pay.example.com/submit.php

# Merchant id (PID)
PAY_PID=1000

# Merchant key (KEY, used for MD5 signing, must match the platform console)
PAY_KEY=your_pay_key_here

# Async notify URL: must be a publicly reachable full URL; the platform calls back here after a successful payment.
# Maps to this service's /api/card/pay_callback/ route (both GET and POST supported).
PAY_NOTIFY_URL=https://your-domain.com/api/card/pay_callback/

# Sync return URL: the page the browser redirects to after the user completes payment at the cashier.
PAY_RETURN_URL=https://your-domain.com/card/

# Product name (shown in the order title on the payment platform)
PAY_PRODUCT_NAME=OMMEGA Annual Card

# Backward-compatible with the old CARD_CALLBACK_SECRET callback method (may be left empty)
CARD_CALLBACK_SECRET=
